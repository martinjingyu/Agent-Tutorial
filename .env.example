# Default provider for run_research_agent.py is DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# Optional OpenAI-compatible fallback/override.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
COMPACTION_MODEL=
AGENT_TEMPERATURE=0.2

# mock, google, or bing
SEARCH_PROVIDER=mock

# Google Custom Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Bing Search
AZURE_SUB_KEY=

SEARCH_RESULTS_PER_PAGE=10
MAX_SELECTABLE_RESULTS=3
