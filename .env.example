# Provider: deepseek, codex, or openai.
AGENT_PROVIDER=deepseek

# DeepSeek Chat Completions mode.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# Codex Responses API mode.
# Auth is read from %USERPROFILE%\.codex\auth.json after `codex login`.
CODEX_MODEL=gpt-5.4
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_HOME=
CODEX_COMPACTION_MODEL=
CODEX_MAX_RETRIES=8
CODEX_RETRY_SLEEP=3.5

# Optional generic OpenAI-compatible mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
COMPACTION_MODEL=
AGENT_TEMPERATURE=0.2
